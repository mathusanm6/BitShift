[gd_scene format=3]

[ext_resource type="Script" path="res://game/menu/menu.gd" id="1_menu"]
[ext_resource type="Theme" path="res://game/ui/instrument_theme.tres" id="2_instrument_theme"]
[ext_resource type="Script" path="res://game/menu/settings_page.gd" id="3_settings_page"]

[node name="Menu" type="PanelContainer"]
theme = ExtResource("2_instrument_theme")
layout_mode = 3
offset_left = 76.0
offset_top = 100.0
offset_right = 540.0
offset_bottom = 140.0
custom_minimum_size = Vector2(464, 0)
script = ExtResource("1_menu")

[node name="Main" type="VBoxContainer" parent="."]
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Main"]
theme_type_variation = &"TitleLabel"
theme_override_font_sizes/font_size = 58
text = "BITSHIFT"
horizontal_alignment = 1

[node name="Tagline" type="Label" parent="Main"]
theme_type_variation = &"CaptionLabel"
text = "SHOOT EACH COLUMN'S LOWEST BIT WITH THE SAME BIT."
horizontal_alignment = 1

[node name="Gap" type="Control" parent="Main"]
layout_mode = 2
custom_minimum_size = Vector2(0, 4)

[node name="Start" type="Button" parent="Main"]
custom_minimum_size = Vector2(0, 48)
text = "START GAME"

[node name="Tutorial" type="Button" parent="Main"]
custom_minimum_size = Vector2(0, 44)
text = "HOW TO PLAY"

[node name="Settings" type="Button" parent="Main"]
