text = "SETTINGS"

[node name="Hint" type="Label" parent="Main"]
theme_type_variation = &"CaptionLabel"
text = "ARROWS TO CHOOSE  ·  ENTER TO SELECT"
horizontal_alignment = 1

[node name="SettingsPage" type="VBoxContainer" parent="."]
theme_override_constants/separation = 14
visible = false
